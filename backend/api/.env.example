PORT=3000
DATABASE_URL=postgresql://quizrealm:replace_with_a_strong_local_password@localhost:5432/quizrealm
JWT_ACCESS_SECRET=replace_with_a_long_random_access_token_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_token_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Cheie distinctă pentru criptarea AES-GCM a secretelor TOTP.
TWO_FACTOR_ENCRYPTION_SECRET=replace_with_a_long_random_two_factor_secret
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# În producție: activează Turnstile și păstrează cheia secretă numai pe server.
CAPTCHA_REQUIRED=false
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=
INTERNAL_API_KEY=replace_with_a_long_random_internal_service_key
# URL public al aplicației, folosit în linkurile trimise pe email.
APP_PUBLIC_URL=http://localhost:3000
# `console` scrie mesajele în loguri (doar dezvoltare). `smtp` cere un provider
# configurat; până atunci, fluxurile de email nu livrează nimic în producție.
MAIL_TRANSPORT=console
