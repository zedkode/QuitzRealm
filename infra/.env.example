# Copy this file to .env for local development and replace every placeholder.

POSTGRES_DB=quizrealm
POSTGRES_USER=quizrealm
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://quizrealm:replace_with_a_strong_local_password@localhost:5432/quizrealm

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

MINIO_ROOT_USER=replace_with_a_local_access_key
MINIO_ROOT_PASSWORD=replace_with_a_strong_local_secret_key
MINIO_BUCKET=quizrealm-assets
MINIO_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

JWT_ACCESS_SECRET=replace_with_a_long_random_access_token_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_token_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret

AI_PROVIDER=openai-compatible
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=replace_with_ai_model_name
AI_VERIFIER_MODEL=replace_with_a_different_verifier_model_name
AI_VERIFIER_MAX_TOKENS=4096
AI_RESPONSE_FORMAT=json_object
AI_REASONING_EFFORT=none
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0
LEADERBOARD_INTERVAL_MS=300000
LEADERBOARD_REDIS_KEY=quizrealm:leaderboard:global
